{
  "name": "scenika",
  "version": "0.1.0",
  "description": "Scenika - parc materiel son et lumiere, location, puissance, DMX",
  "author": "Colin Meng",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node tests/dmx.mjs && node tests/traductions.mjs && node tests/coherence-site.mjs",
    "verifier": "npm run typecheck && npm test",
    "site:preparer": "node scripts/preparer-site.mjs",
    "package:win": "electron-vite build && electron-builder --win --publish never",
    "publish:win": "electron-vite build && electron-builder --win --publish always",
    "package:linux": "electron-vite build && electron-builder --linux --publish never",
    "publish:linux": "electron-vite build && electron-builder --linux --publish always"
  },
  "main": "./out/main/index.js",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.2.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}