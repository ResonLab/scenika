{
  "name": "scenika",
  "version": "0.3.0",
  "description": "Scenika - parc materiel son et lumiere, location, puissance, DMX",
  "author": "Colin Meng",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node tests/dmx.mjs && node tests/doublons.mjs && node tests/puissance.mjs && node tests/tableaux.mjs && node tests/locations.mjs && node tests/scene.mjs && node tests/serveur.mjs && node tests/coherence-conditions.mjs && node tests/traductions.mjs && node tests/effets-react.mjs && node tests/atteignable.mjs && node tests/coherence-site.mjs && node tests/coherence-guide.mjs",
    "verifier": "npm run typecheck && npm test",
    "site:preparer": "node scripts/preparer-site.mjs",
    "package:win": "electron-vite build && electron-builder --win --publish never",
    "publish:win": "electron-vite build && electron-builder --win --publish always",
    "package:linux": "electron-vite build && electron-builder --linux --publish never",
    "publish:linux": "electron-vite build && electron-builder --linux --publish always",
    "serveur:build": "node scripts/construire-serveur.mjs",
    "serveur": "node scripts/construire-serveur.mjs && node out/serveur/scenika-serveur.mjs",
    "conditions:publier": "node scripts/publier-conditions.mjs",
    "guide:publier": "node scripts/publier-guide.mjs",
    "guide:pdf": "electron scripts/guide-pdf.mjs"
  },
  "main": "./out/main/index.js",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "nexika": "github:ResonLab/nexika",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
