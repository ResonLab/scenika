# npm 12 refuse par defaut les dependances git (allow-git = none).
# Scenika en a besoin d une seule : nexika, le serveur commun, qui n est pas
# publie sur le registre npm.
#
# root autorise les dependances git declarees par CE projet, et refuse celles
# qu une dependance amenerait dans son dos. all ouvrirait les deux.
allow-git=root
