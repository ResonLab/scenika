{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Nexika designe ses modules internes avec leur extension .ts, pour que
    // Node puisse le charger seul, sans empaqueteur.
    "allowImportingTsExtensions": true,
    "types": ["node", "electron-vite/node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true
  },
  "include": ["src/main/**/*",
    "src/serveur/**/*", "src/preload/**/*", "src/partage/**/*", "commun/**/*", "electron.vite.config.ts"]
}
